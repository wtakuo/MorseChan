# Code style for MorseChan (same as MorseComm) (clang-format). Format with:
#   clang-format -i *.cpp *.h test/host/*.cpp
#   clang-format --assume-filename=MorseChan.cpp < MorseChan.ino > tmp && mv tmp MorseChan.ino
BasedOnStyle: Google
IndentWidth: 4
ContinuationIndentWidth: 4
AccessModifierOffset: -2
UseTab: Never
ColumnLimit: 80
SortIncludes: Never
IncludeBlocks: Preserve
DerivePointerAlignment: false
PointerAlignment: Left
ReflowComments: true
